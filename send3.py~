#!/usr/bin/env python3
# flood_send_only.py
import argparse, socket, struct, time

FLOOD_PORT = 5003

def px_payload(group_ip: str, seq: int, extra: bytes) -> bytes:
    # PX = group_ip (32 bits) + seq (16 bits)
    return struct.pack("!4sH", socket.inet_aton(group_ip), seq) + extra

ap = argparse.ArgumentParser(description="Send FLOOD (UDP dst 5003) with PX header (group_ip+seq)")
ap.add_argument("--dst", required=True, help="Destination IP (e.g. 239.1.1.1 or 10.0.2.2)")
ap.add_argument("--iface", required=True, help="Source interface IP (e.g. 10.0.1.1)")
ap.add_argument("--group", required=True, help="Value put into PX.group_ip (used by your P4 to compute idx)")
ap.add_argument("--seq", type=int, default=1, help="Starting sequence number")
ap.add_argument("--count", type=int, default=1, help="How many packets to send")
ap.add_argument("--interval", type=float, default=0.3, help="Delay between packets")
ap.add_argument("--ttl", type=int, default=4, help="Multicast TTL (only matters if --dst is multicast)")
ap.add_argument("--msg", default="FLOOD", help="Extra payload after PX (string)")
args = ap.parse_args()

s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)

# If dst is multicast, pick the outgoing interface + TTL
s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_IF, socket.inet_aton(args.iface))
s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, args.ttl)

extra = args.msg.encode("utf-8", errors="replace")

for i in range(args.count):
    seq = args.seq + i
    payload = px_payload(args.group, seq, extra)
    s.sendto(payload, (args.dst, FLOOD_PORT))
    print(f"[SEND] iface={args.iface} -> {args.dst}:{FLOOD_PORT}  px.group={args.group} seq={seq} len={len(payload)}")
    if i + 1 < args.count:
        time.sleep(args.interval)
