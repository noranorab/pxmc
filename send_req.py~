from scapy.all import *
import struct

REQ_PORT = 5000
GROUP_IP = "239.0.0.1"
SEQ = 10

group_raw = struct.unpack("!I", socket.inet_aton(GROUP_IP))[0]
px_payload = struct.pack("!IH", group_raw, SEQ)

pkt = (
    Ether(dst="ff:ff:ff:ff:ff:ff") /
    IP(src="10.0.1.1", dst="10.0.1.2") /
    UDP(sport=1234, dport=REQ_PORT) /
    Raw(load=px_payload)
)

print("Sending REQ")
sendp(pkt, iface="eth0")
